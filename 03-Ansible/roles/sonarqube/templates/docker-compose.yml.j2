# ==============================================================================
# SonarQube stack — managed by Ansible (roles/sonarqube)
# ==============================================================================
# Changes here are overwritten on the next playbook run. Edit the template at
# 03-Ansible/roles/sonarqube/templates/docker-compose.yml.j2 instead.
# ==============================================================================

name: sonarqube

services:

  # ----------------------------------------------------------------------------
  # PostgreSQL — SonarQube's database
  # ----------------------------------------------------------------------------
  # SonarQube can run on an embedded H2 database, but ONLY for evaluation: it
  # cannot be upgraded, cannot be backed up consistently, and SonarQube refuses
  # to start on H2 in any configuration that looks like production.
  # ----------------------------------------------------------------------------
  db:
    image: postgres:15-alpine
    container_name: sonarqube-db
    restart: unless-stopped

    environment:
      POSTGRES_USER: {{ sonarqube_db_user }}
      POSTGRES_PASSWORD: ${SONARQUBE_DB_PASSWORD:?SONARQUBE_DB_PASSWORD is required}
      POSTGRES_DB: {{ sonarqube_db_name }}

    volumes:
      # Bind mount rather than a named volume so the data location is explicit
      # and easy to back up with a plain tar of {{ sonarqube_data_dir }}.
      - {{ sonarqube_data_dir }}/postgresql:/var/lib/postgresql/data

    networks:
      - sonarnet

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ sonarqube_db_user }} -d {{ sonarqube_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ----------------------------------------------------------------------------
  # SonarQube server
  # ----------------------------------------------------------------------------
  sonarqube:
    image: {{ sonarqube_image }}
    container_name: sonarqube
    restart: unless-stopped

    depends_on:
      db:
        # SonarQube crashes on startup if PostgreSQL is not yet accepting
        # connections, and Compose would otherwise restart-loop it.
        condition: service_healthy

    environment:
      SONAR_JDBC_URL: jdbc:postgresql://db:5432/{{ sonarqube_db_name }}
      SONAR_JDBC_USERNAME: {{ sonarqube_db_user }}
      SONAR_JDBC_PASSWORD: ${SONARQUBE_DB_PASSWORD:?SONARQUBE_DB_PASSWORD is required}

      # Heap sizes for the two JVMs SonarQube runs. The defaults assume a much
      # larger machine; these fit alongside Jenkins on a t3.medium.
      SONAR_WEB_JAVAOPTS: "-Xmx{{ sonarqube_web_heap }} -Xms256m"
      SONAR_CE_JAVAOPTS: "-Xmx{{ sonarqube_ce_heap }} -Xms256m"
      SONAR_SEARCH_JAVAOPTS: "-Xmx{{ sonarqube_search_heap }} -Xms{{ sonarqube_search_heap }}"

    volumes:
      - {{ sonarqube_data_dir }}/data:/opt/sonarqube/data
      - {{ sonarqube_data_dir }}/extensions:/opt/sonarqube/extensions
      - {{ sonarqube_data_dir }}/logs:/opt/sonarqube/logs

    networks:
      - sonarnet

    ports:
      - "{{ sonarqube_port }}:9000"

    ulimits:
      # Elasticsearch requires a high file-descriptor limit and refuses to start
      # below 65535, failing a bootstrap check with a message about "max file
      # descriptors [4096] for elasticsearch process is too low".
      nofile:
        soft: 65536
        hard: 65536
      # Unlimited address space — Elasticsearch memory-maps its index files.
      nproc: 8192

    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget --no-verbose --tries=1 --spider
          http://localhost:9000/api/system/status || exit 1
      interval: 30s
      timeout: 10s
      retries: 10
      # First boot runs the database migration and builds the search index.
      start_period: 180s

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  sonarnet:
    driver: bridge

# ==============================================================================
# LOCAL BACKEND OVERRIDE — for offline validation only
# ==============================================================================
# Terraform treats any file named `*_override.tf` specially: it is merged LAST
# and REPLACES matching blocks from the normal configuration. That makes it the
# supported way to swap the S3 backend for a local one without editing
# backend.tf.
#
# Use this to run `terraform plan` before the bootstrap S3 bucket exists — a
# plan is read-only and creates nothing, so it is a safe way to prove the
# configuration resolves against real AWS (AMI lookups, EKS add-on versions,
# IAM policy parsing) which `terraform validate` cannot check.
#
# ------------------------------------------------------------------------------
# HOW TO USE
# ------------------------------------------------------------------------------
#     cp zz_local_backend_override.tf.disabled zz_local_backend_override.tf
#     terraform init -reconfigure
#     terraform plan
#
#     # then ALWAYS remove it before any real work:
#     rm zz_local_backend_override.tf
#     terraform init -reconfigure -backend-config=backend.hcl
#
# ------------------------------------------------------------------------------
# ⚠️  NEVER APPLY WITH THIS ACTIVE
# ------------------------------------------------------------------------------
# It writes terraform.tfstate to the local disk. Applying real infrastructure
# against local state defeats the entire purpose of the S3 backend: the state is
# unshared, unversioned, unlocked, and one laptop failure away from losing the
# only record of what exists in AWS.
#
# The file ships with a `.disabled` suffix so it cannot take effect by accident,
# and the active `.tf` name is listed in .gitignore.
# ==============================================================================

terraform {
  backend "local" {
    path = "terraform.tfstate"
  }
}

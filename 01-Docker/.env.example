# ==============================================================================
# Environment template for the local Docker Compose stack
# ==============================================================================
# Usage:
#     cp .env.example .env
#     # edit .env and replace every CHANGE_ME value
#     docker compose up --build -d
#
# .env is listed in .gitignore and MUST NEVER be committed. This .example file
# is committed instead so that anyone cloning the repository knows exactly which
# variables are required, without any real secret entering Git history.
#
# Generate strong values with:
#     openssl rand -base64 24        # Linux / macOS / Git Bash
#     [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))   # PowerShell
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL
# ------------------------------------------------------------------------------
# Superuser password. Used only by the MySQL container itself and by the
# healthcheck — the application never authenticates as root.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# Database the auth-service connects to. MySQL creates it automatically on
# first boot via the MYSQL_DATABASE variable.
MYSQL_DATABASE=ivolve

# Least-privilege application account. MySQL grants it full rights on
# ${MYSQL_DATABASE} only — it cannot touch other schemas.
MYSQL_USER=ivolve_user
MYSQL_PASSWORD=CHANGE_ME_app_password

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# HMAC key that signs the express-session cookie.
# server.js falls back to the literal string "change-me-in-k8s" when this is
# unset; anyone who knows that value can forge a session cookie for any user and
# skip authentication completely. Always override it.
SESSION_SECRET=CHANGE_ME_long_random_session_secret
